{
  "name": "cappr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "shared"
  ],
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "npm run dev --workspace @cappr/client",
    "build": "npm run build --workspace @cappr/client",
    "preview": "npm run preview --workspace @cappr/client",
    "typecheck": "npm run typecheck --workspace @cappr/shared && npm run build --workspace @cappr/client",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
