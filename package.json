{
  "name": "nudge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nudge/client",
    "build": "npm run build --workspace @nudge/client",
    "preview": "npm run preview --workspace @nudge/client",
    "typecheck": "npm run typecheck --workspace @nudge/shared && npm run build --workspace @nudge/client",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
